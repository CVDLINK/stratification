  },
  "task": {
    "prediction_target": "Binary 12-month arrhythmic-event risk (high vs low).",
    "evaluation_protocol": "Held-out 20% test partition plus one external multi-site validation; AUC-ROC, F1, sensitivity and specificity reported."
  },
  "deployment": {
    "deployer": "Hospital cardiology departments within the EU",
    "ai_subject": "Adult patients (age 18\u201385) undergoing a routine resting 12-lead ECG",
    "automation_level": "human_in_the_loop",
    "human_oversight": "A cardiologist reviews every risk score alongside clinical history before any decision; the model never triggers action autonomously.",
    "actors": [
      {
        "role": "Cardiologist",
        "intended": true,
        "active": true,
        "informed": true,
        "control": "correct"
      },
      {
        "role": "Primary care physician",
        "intended": true,
        "active": true,
        "informed": true,
        "control": "opt_out"
      },
      {
        "role": "Patient",
        "intended": true,
        "active": false,
        "informed": true,
        "control": "challenge"
      }
    ],
