  "@id": "https://github.com/example-org/heartwatch-ecg",
  "@type": "cvd:AICard",
  "card_metadata": {
    "card_version": "1.0.0",
    "card_language": "en",
    "card_publisher": "CVDLINK Consortium",
    "card_date": "2026-10-13",
    "spec_url": "heartwatch-ecg.jsonld"
  },
  "identity": {
    "system_name": "EXAMPLE \u2014 HeartWatch-ECG Arrhythmic Risk Classifier",
    "short_title": "EXAMPLE HeartWatch-ECG",
    "short_description": "A deep-learning model that estimates a patient's 12-month risk of a life-threatening ventricular arrhythmia from a resting 12-lead ECG. Illustrative example of a standalone clinical classifier.",
    "version": "1.0.0",
    "modality": "software",
    "model_type": "classification",
    "artifact_role": "standalone_system",
    "ai_techniques": [
      "Deep learning",
      "1D convolutional neural network",
      "Transformer encoder",
      "ECG signal processing"
    ],
    "keywords": [
      "cardiology",
      "ecg",
      "arrhythmia",
      "risk prediction",
      "deep learning"
    ]
  },
  "provenance": {
    "providers": [
      "CVDLINK Consortium"
    ],
    "developers": [
      "Meridian Cardiac AI Lab (example)"
    ],
    "contacts": [
      {
        "name": "L. Ahonen (example)",
        "institution": "Meridian Cardiac AI Lab",
        "email": "l.ahonen@example.org",
        "@type": "schema:Person"
      }
    ],
    "funding": "EU Horizon Europe \u2014 CVDLINK (GA 101137278)"
  },
  "intended": {
    "domain": "Healthcare \u2014 Cardiology",
    "purpose": "Estimate a patient's 12-month risk of a life-threatening ventricular arrhythmia from a resting 12-lead ECG, as decision support for cardiologists.",
    "capability": "Supervised time-series classification on 12-lead ECG waveforms.",
    "out_of_scope_uses": [
      "Pediatric patients (under 18)",
      "Real-time or acute arrhythmia alarms",
      "Autonomous clinical decisions without physician review",
      "Patients with implanted pacemakers or defibrillators"
    ],
    "surrogate_marker": {
      "predicts": false,
      "details": "Predicts the clinical outcome (arrhythmic event within 12 months) directly, not a surrogate marker."
    }
  },
  "io": {
    "input_description": "Resting 12-lead ECG (10 seconds, 500 Hz), stored as a WFDB record.",
    "output_description": "A 12-month arrhythmic-risk score in [0,1] with a 95% confidence interval and a high/low band."
  },
  "components": [
    {
      "name": "HeartWatch-Net",
      "type": "model",
      "version": "1.0.0",
      "documentation_link": {
        "@id": "internal://models/heartwatch-net/model-card"
      },
      "@type": "cvd:Component"
    },
    {
      "name": "NordECG-Arrhythmia Cohort",
      "type": "dataset",
      "version": "2.0.0",
      "documentation_link": {
        "@id": "internal://datasets/nordecg-arrhythmia/datasheet"
      },
      "@type": "cvd:Component"
    },
    {
      "name": "ECG Preprocessing Pipeline",
      "type": "system",
      "version": "1.4.0",
      "documentation_link": {
        "@id": "internal://systems/ecg-preprocess/docs"
      },
      "@type": "cvd:Component"
    }
  ],
  "data": {
    "datasets": [
      {
        "name": "NordECG-Arrhythmia Cohort",
        "description": "Resting 12-lead ECG waveforms linked to 12-month arrhythmic-event outcome labels from hospital records.",
        "cohort": "Adults referred to cardiology outpatient clinics with a suspected arrhythmia, enriched for atrial fibrillation relative to the general population. Three Nordic centres. Patients under 40 are sparsely represented and no paediatric patients are included.",
        "origin": "real",
        "ethics_approval": true,
        "availability": "on_request",
        "location_or_request": "Available to approved researchers via the CVDLINK Secure Processing Environment after data-access-committee review.",
        "used_for_training": true,
        "bias_checked": true,
        "bias_details": "Checked for age and sex representation; mild under-representation of patients under 40 noted.",
        "n_samples": 62000,
        "n_features": 5000,
        "preprocessing": [
          "Baseline-wander removal",
          "Normalization",
          "Missing-lead handling"
        ],
        "personal_data": true,
        "personal_data_category": "Health data (ECG recordings)",
        "dpia_conducted": true,
        "non_personal_data": false,
        "anonymised": true,
        "licenced": true,
        "@type": [
          "dcat:Dataset",
          "ai:TrainingData"
        ]
      },
      {
        "name": "EuroECG-Val (external)",
        "description": "Independent multi-site 12-lead ECG validation set with arrhythmic-event follow-up.",
        "origin": "real",
        "ethics_approval": true,
        "availability": "restricted",
        "location_or_request": "Held at partner sites; accessible only under a signed data-use agreement.",
        "used_for_training": false,
        "bias_checked": true,
        "bias_details": "Site and device distribution reviewed; performance reported per site.",
        "n_samples": 14500,
        "n_features": 5000,
        "personal_data": true,
        "personal_data_category": "Health data (ECG recordings)",
        "dpia_conducted": true,
        "non_personal_data": false,
        "anonymised": true,
        "licenced": true,
        "@type": [
          "dcat:Dataset",
          "ai:TestingData"
        ]
      }
    ]
  },
  "metrics": [
    {
      "name": "AUC-ROC",
      "value": 0.81,
      "range": "0-1",
      "dataset": "NordECG-Arrhythmia Cohort",
      "split": "held_out",
      "split_detail": "20% held-out test partition, split by patient",
      "higher_is_better": true,
      "@type": "cvd:Metric"
    },
    {
      "name": "AUC-ROC",
      "value": 0.76,
      "range": "0-1",
      "dataset": "EuroECG-Val (external)",
      "split": "external_validation",
      "higher_is_better": true,
      "@type": "cvd:Metric"
    },
    {
      "name": "F1",
      "value": 0.64,
      "range": "0-1",
      "dataset": "NordECG-Arrhythmia Cohort",
      "split": "held_out",
      "split_detail": "20% held-out test partition, split by patient",
      "higher_is_better": true,
      "@type": "cvd:Metric"
    },
    {
      "name": "Sensitivity",
      "value": 0.79,
      "range": "0-1",
      "dataset": "NordECG-Arrhythmia Cohort",
      "split": "held_out",
      "split_detail": "20% held-out test partition, split by patient",
      "higher_is_better": true,
      "@type": "cvd:Metric"
    },
    {
      "name": "Specificity",
      "value": 0.71,
      "range": "0-1",
      "dataset": "NordECG-Arrhythmia Cohort",
      "split": "held_out",
      "split_detail": "20% held-out test partition, split by patient",
      "higher_is_better": true,
      "@type": "cvd:Metric"
    }
  ],
  "limitations": {
    "known_limitations": [
      "Trained mainly on a Northern-European population; generalisability elsewhere not yet validated.",
      "Performance degrades on noisy ECGs (lead detachment, motion artefact).",
      "Not validated for patients with implanted cardiac devices.",
      "12-month prediction horizon; not suitable for acute risk alerting."
    ],
    "groups_with_lower_performance": [
      "Patients under 40 (under-represented in training data).",
      "Patients with atrial fibrillation (differing signal morphology)."
    ]
  },
  "predetermined_changes": [
    {
      "subject": "Model weights (retraining)",
      "frequency": "6 months",
      "impact_on_performance": true,
      "impact_on_risks": true,
      "@type": "cvd:PredeterminedChange"
    },
    {
      "subject": "Training dataset refresh",
      "frequency": "12 months",
      "impact_on_performance": true,
      "impact_on_risks": true,
      "@type": "cvd:PredeterminedChange"
    }
  ],
